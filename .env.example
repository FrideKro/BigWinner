# -----------------------------------------------------------------------------
# 数据库连接
#     DB_HOST                       库地址（IP/域名）
#     DB_PORT                       默认：5432
#     DB_NAME/_USER/_PASSWORD       库名/用户/密码
#     DB_SSLMODE                    默认：disable
# -----------------------------------------------------------------------------
DB_HOST=192.168.1.11
DB_PORT=5432
DB_NAME=big_winner
DB_USER=big_winner
DB_PASSWORD=your_password_here
DB_SSLMODE=disable

# -----------------------------------------------------------------------------
# 初始管理员与系统默认配置（首次启动建表时自动初始化）
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_NICKNAME=群主管理员
ADMIN_PASSWORD=admin123
DEFAULT_ROOM_FEE=100
PORT=3000

# -----------------------------------------------------------------------------
# 生产部署（仅 deploy-prod.sh 与 docker-compose.yml 使用；本地开发可全部留空）
#     IMAGE_NAME  镜像名。默认 localhost/big-winner（本地构建产物，不拉取）；
#                 GHCR 部署时设为 ghcr.io/<owner>/<repo>（deploy workflow 自动注入）
#     IMAGE_TAG   部署镜像版本，默认 latest（可在 .env 指定，或由 deploy workflow 注入）
# -----------------------------------------------------------------------------
# IMAGE_NAME=ghcr.io/owner/bigwinner
# IMAGE_TAG=latest
