# -----------------------------------------------------------------------------
# 数据库连接（docker compose 默认自带 postgres:17-alpine 零配置启动；连接外部库时再取消注释修改）
#     DB_HOST                       库地址（IP/域名），本地开发默认 127.0.0.1，compose 默认 db
#     DB_PORT                       默认：5432
#     DB_NAME/_USER/_PASSWORD       库名/用户/密码（compose 默认均为 big_winner）
#     DB_SSLMODE                    默认：disable
#     DATABASE_URL                  完整连接串，设置后优先于上方 DB_* 各项
# -----------------------------------------------------------------------------
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=big_winner
# DB_USER=big_winner
# DB_PASSWORD=big_winner
# DB_SSLMODE=disable
# DATABASE_URL=postgresql://big_winner:password@127.0.0.1:5432/big_winner

# -----------------------------------------------------------------------------
# 初始管理员与系统默认配置（首次启动建表时自动初始化，未设置时走代码内默认值）
#     ADMIN_USERNAME                管理员账号，默认：admin
#     ADMIN_NICKNAME                管理员昵称，默认：管理员
#     ADMIN_PASSWORD                管理员密码，默认：admin@123456
#     DEFAULT_ROOM_FEE              单场默认房费，默认：100
#     APP_PORT                      宿主机映射端口，默认：3000
# -----------------------------------------------------------------------------
# ADMIN_USERNAME=admin
# ADMIN_NICKNAME=管理员
# ADMIN_PASSWORD=admin@123456
# DEFAULT_ROOM_FEE=100
# APP_PORT=3000

# Cookie 是否带 Secure 标记（HTTPS 部署时设为 true，默认：false）
# COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# 生产部署（仅 deploy-prod.sh 与 docker-compose.yml 使用；本地开发可全部留空）
#     IMAGE_NAME  镜像名。默认 localhost/big-winner（本地构建产物，不拉取）；
#                 使用官方公开镜像时设为 ghcr.io/fridekro/bigwinner；
#                 fork 自行发版为 ghcr.io/<owner>/<repo>（deploy workflow 自动注入）
#     IMAGE_TAG   部署镜像版本，默认 latest（可在 .env 指定，或由 deploy workflow 注入）
# -----------------------------------------------------------------------------
# IMAGE_NAME=ghcr.io/fridekro/bigwinner
# IMAGE_TAG=latest
